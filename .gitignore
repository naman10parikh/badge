# wikimem
.wikimem-cache/
node_modules/

# TypeScript build output (generated by `pnpm build`)
dist/

# WikiMem test vault personal data
my-wiki/raw/
tools/agentgrid/app/release/

packages/web/.next/
*.pack

# macOS metadata
**/.DS_Store

# Ephemeral harness state (never commit)
.claude/worktrees/
.claude/backups/
.claude/scheduled_tasks.lock
.claude/vp-signals/*.done
.claude/vp-signals/*.needs-qa
.claude/vp-signals/*.migrating

# Obsidian temp files
vault/Untitled*.base

# Eval state — regenerated on every `npm run eval` (the cockpit + RSI engine read it fresh).
# NOTE: logs/runs.jsonl is intentionally NOT ignored (append-only observability, HARNESS-OVERRIDES §10).
eval/state.json

# Playwright artifacts (cockpit G2) — regenerated per run, never committed.
test-results/
playwright-report/

.env
.env.*
