# badge — environment variables (shape only; copy to .env and fill in)
# .env is gitignored. NEVER commit real key values. The acceptance test uses Clerk TEST keys only.

# ── Anthropic (the RSI Claude-half + any claude -p call) ──────────────────────
# Get at: https://console.anthropic.com/settings/keys
# Ported from energy/.env (port-keys pattern). Present.
ANTHROPIC_API_KEY=sk-ant-...

# ── E2B (OPTIONAL sandbox) ────────────────────────────────────────────────────
# Get at: https://e2b.dev/dashboard
# OPTIONAL — the GitHub Actions ubuntu runner is the documented sandbox alt (E5).
# badge's acceptance test does NOT require E2B; its absence does not block the bar.
E2B_API_KEY=e2b_...

# ── Clerk TEST keys — the acceptance bar's ONLY live keys (S1) ────────────────
# Get at: https://dashboard.clerk.com → (create/select an app) → API Keys.
# MUST be the TEST instance (pk_test_ / sk_test_), never live. The acceptance
# test (badge init --provider clerk → Playwright sign-in→protected E2E) needs
# all four. If absent, the acceptance.yml CI job FAILS LOUD (not skipped) — that
# is by design (PLAN §5/§8). Provisioning requires a Clerk login/signup which can
# hit 2FA/phone → see CHAIRMAN-CHECKLIST.md (S1).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# A pre-seeded Clerk TEST user for the sign-in (use +clerk_test addressing so no
# real email round-trip is needed; Clerk test mode bypasses bot checks for it).
CLERK_TEST_USER_EMAIL=your+clerk_test@example.com
CLERK_TEST_USER_PASSWORD=...
# Optional route overrides (the scaffold defaults to /sign-in, /dashboard).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# ── RSI Claude-half (DEFERRED — D8) ───────────────────────────────────────────
# The deterministic RSI engine (workflows/rsi.workflow.js) runs $0/tokenless
# WITHOUT this. Set it to light the Claude half (brain-file rewrite on a real
# watchlist delta). Its absence is NOT a gap. See CHAIRMAN-CHECKLIST.md.
# CLAUDE_CODE_OAUTH_TOKEN=...

# ── NOT needed for the C1 bar (documented, NOT provisioned) ───────────────────
# The brain reasons about these providers WITHOUT live keys; they become Required
# only if/when a `badge init --provider workos|stytch|...` acceptance test is added.
# WORKOS_API_KEY=...
# WORKOS_CLIENT_ID=...
# STYTCH_PROJECT_ID=...
# STYTCH_SECRET=...
# AUTH0_DOMAIN=...
# AUTH0_CLIENT_ID=...
# AUTH0_CLIENT_SECRET=...
# BETTER_AUTH_SECRET=...
